# PromptRush Environment Variables Template

# Supabase Configuration
# Obtain these from your Supabase project dashboard (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Authentication
# Used for protected admin dashboard access
ADMIN_EMAIL=admin@promptrush.internal
ADMIN_PASSWORD=change_this_secure_admin_password_123!

